# Anishka Inventory — Environment Variables Template
# Anishka Industries, Milestone Khandsa Road, Sector-10, Gurugram
# Copy this file to .env and fill in your values

# ── Admin Credentials ──────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@2026

# ── Security & Testing ─────────────────────────────────────────────
# IMPORTANT: Must be false in production environments. Set true only during automated test runs.
ALLOW_TEST_ROLE_HEADER=false

# ── CORS Allowed Origins ───────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Groq AI Copilot ────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ── Database URL ───────────────────────────────────────────────────
# SQLite local development (default):
DATABASE_URL=sqlite:///./anishka_inventory.db
# PostgreSQL for production deployment:
# DATABASE_URL=postgresql://user:password@host:5432/anishka_inventory

# ── Background Telemetry Simulator ─────────────────────────────────
# Set to true to start the background stock movement simulator automatically (default: false)
SIMULATOR_ENABLED=false

# ── Outbound Supplier Email (SMTP) ─────────────────────────────────
# When configured, approved PO PDFs are dispatched via real SMTP.
# If omitted, outbox records are marked SIMULATED for demo safety.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=orders@anishkaindustries.com
